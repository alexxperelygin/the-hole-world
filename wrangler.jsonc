{
  // Cloudflare Workers static-assets deploy of the Vite build. Phase 2 adds the API worker in worker/ with its own config.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-hole-world",
  "main": "site/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "routes": [{ "pattern": "thehole.world", "custom_domain": true }, { "pattern": "www.thehole.world", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  }
}
